/* detail.qss */

#DetailView {
    background-color: {{bg_secondary}};
    border-left: 1px solid {{border_color}};
}

#DetailTitle {
    color: {{text_primary}};
    font-size: 15px;
    font-weight: 700;
}

#DetailUrlButton {
    color: {{accent_color}};
    font-size: 11px;
    text-decoration: underline;
    text-align: left;
    border: none;
    background: transparent;
    padding: 0;
}

#DetailCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}

#DetailCloseButton:hover {
    background-color: {{border_color}};
}

#StatusCombo,
#ProgressSpin {
    background-color: {{bg_primary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 4px 8px;
}

#NotesEdit {
    background-color: {{bg_primary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* --- Yeni Kaynak Formu --- */

#ResourceForm {
    background-color: {{bg_secondary}};
}

#FormHeader {
    color: {{text_primary}};
    font-size: 14px;
    font-weight: 700;
}

#FormField,
#FormCombo,
#FormTextEdit {
    background-color: {{bg_primary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

#FormField:focus,
#FormTextEdit:focus {
    border-color: {{accent_color}};
}

#SaveButton {
    background-color: {{accent_color}};
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
}

#SaveButton:hover {
    background-color: {{accent_color}}cc;
}

#CancelButton {
    background-color: transparent;
    color: {{text_secondary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 6px 12px;
}

#CancelButton:hover {
    background-color: {{border_color}};
}

/* --- Kaynak isleme butonlari --- */

#SaveNotesButton {
    background-color: transparent;
    color: {{accent_color}};
    border: 1px solid {{accent_color}};
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
}

#SaveNotesButton:hover {
    background-color: {{accent_color}}22;
}

#EditResourceButton {
    background-color: {{accent_color}};
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

#EditResourceButton:hover {
    background-color: {{accent_color}}cc;
}

#DeleteResourceButton {
    background-color: transparent;
    color: #ff6b6b;
    border: 1px solid #ff6b6b;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
}

#DeleteResourceButton:hover {
    background-color: #ff6b6b22;
}

#DeleteResourceConfirmButton {
    background-color: #ff4444;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Inline Banner --- */

#InlineBanner {
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

#InlineBanner[severity="error"] {
    background-color: #ff4444;
    color: #ffffff;
}

#InlineBanner[severity="info"] {
    background-color: {{accent_color}};
    color: #ffffff;
}
