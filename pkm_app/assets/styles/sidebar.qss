/* sidebar.qss */

#Sidebar {
    background-color: {{bg_secondary}};
    border-right: 1px solid {{border_color}};
}

#SidebarTitle {
    color: {{text_primary}};
    font-size: 13px;
    font-weight: 700;
    padding: 4px 0;
}

#SidebarSectionLabel {
    color: {{text_secondary}};
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 4px 2px 4px;
}

#SidebarNavList,
#SidebarCategoryList,
#SidebarTagList {
    background: transparent;
    border: none;
    outline: none;
}

#SidebarNavList::item,
#SidebarCategoryList::item,
#SidebarTagList::item {
    color: {{text_primary}};
    border-radius: 6px;
    padding: 6px 10px;
}

#SidebarNavList::item:selected,
#SidebarCategoryList::item:selected,
#SidebarTagList::item:selected {
    background-color: {{accent_color}}33;
    color: {{accent_color}};
}

#SidebarNavList::item:hover,
#SidebarCategoryList::item:hover,
#SidebarTagList::item:hover {
    background-color: {{border_color}};
}

#ThemeToggleButton {
    background: transparent;
    color: {{text_secondary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 6px;
    text-align: left;
}

#ThemeToggleButton:hover {
    background-color: {{border_color}};
    color: {{text_primary}};
}
