/* sidebar.qss */

#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 {{surface_elevated}}, stop:1 {{bg_secondary}});
    border-right: 1px solid {{border_color}};
}

#SidebarTitle {
    color: {{text_primary}};
    font-size: 14px;
    font-weight: 800;
    padding: 6px 0;
}

#SidebarSectionLabel {
    color: {{text_secondary}};
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 4px 2px 4px;
}

#SidebarNavList,
#SidebarCategoryList,
#SidebarTagList {
    background: transparent;
    border: none;
    outline: none;
}

#SidebarNavList::item,
#SidebarCategoryList::item,
#SidebarTagList::item {
    color: {{text_primary}};
    border-radius: 8px;
    padding: 8px 10px;
}

#SidebarNavList::item:selected,
#SidebarCategoryList::item:selected,
#SidebarTagList::item:selected {
    background-color: {{nav_selected_bg}};
    color: {{accent_color}};
    font-weight: 700;
}

#SidebarNavList::item:hover,
#SidebarCategoryList::item:hover,
#SidebarTagList::item:hover {
    background-color: {{surface_hover}};
}

#HamburgerButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#HamburgerButton:hover {
    background-color: {{surface_hover}};
}

#ThemeToggleLabel {
    color: {{text_secondary}};
    font-size: 13px;
    font-weight: 500;
}

