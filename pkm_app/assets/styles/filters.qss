/* filters.qss — FilterBar bilesenleri */

#FilterBar {
    background: transparent;
}

#FilterLabel {
    color: {{text_secondary}};
    font-size: 11px;
    font-weight: 600;
    padding-left: 4px;
}

#FilterCombo,
#FilterTagButton {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    min-height: 22px;
}

#FilterCombo:hover,
#FilterTagButton:hover {
    border-color: {{accent_color}};
}

#FilterCombo::drop-down,
#FilterTagButton::menu-indicator {
    border: none;
}

#FilterTagList {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
}

#FilterChip {
    background: transparent;
    color: {{text_secondary}};
    border: 1px solid {{border_color}};
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#FilterChip:hover {
    color: {{text_primary}};
    border-color: {{accent_color}};
}

#FilterChip:checked {
    background-color: {{accent_color}};
    color: {{on_accent}};
    border-color: {{accent_color}};
}

#FilterClearButton {
    background: transparent;
    color: {{text_secondary}};
    border: none;
    padding: 4px 8px;
    font-size: 12px;
}

#FilterClearButton:hover {
    color: {{danger_color}};
}

/* Kart uzerindeki pin/favori ikon butonlari */
#CardIconButton {
    background: transparent;
    border: none;
    padding: 2px;
}

#CardIconButton:hover {
    background-color: {{surface_hover}};
    border-radius: 4px;
}
