/* cards.qss */

#ResourceCard {
    background-color: {{surface_elevated}};
    border-radius: 12px;
}

#ResourceCard:hover {
    background-color: {{surface_hover}};
}

#CardTitle {
    color: {{text_primary}};
    font-size: 14px;
    font-weight: 700;
}

#CardDescription {
    color: {{text_secondary}};
    font-size: 11px;
}

#CardDate {
    color: {{text_secondary}};
    font-size: 10px;
}

/* --- URL Rich Card --- */

#UrlRichCard {
    background-color: {{surface_elevated}};
    border-radius: 12px;
}

#UrlRichCard:hover {
    background-color: {{surface_hover}};
}

#UrlCardTitle {
    color: {{text_primary}};
    font-size: 15px;
    font-weight: 700;
}

#UrlCardDesc {
    color: {{text_secondary}};
    font-size: 12px;
}

#CardThumbnail {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{thumbnail_bg}}, stop:1 {{surface_hover}});
    border-radius: 12px 12px 0 0;
}

#UrlOpenButton {
    background: transparent;
    color: {{accent_color}};
    border: 1px solid {{accent_color}};
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 700;
}

#UrlOpenButton:hover {
    background-color: {{nav_selected_bg}};
    border-color: {{accent_secondary}};
    color: {{accent_secondary}};
}
