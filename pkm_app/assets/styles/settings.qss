/* settings.qss */

#SettingsView {
    background-color: {{bg_primary}};
}

#SettingsHeader {
    color: {{text_primary}};
    font-size: 18px;
    font-weight: 700;
}

#SettingsTabs {
    background-color: {{bg_primary}};
    color: {{text_primary}};
}

#SettingsTabs QTabBar::tab {
    background-color: {{surface_elevated}};
    color: {{text_secondary}};
    padding: 6px 20px;
    border: 1px solid {{border_color}};
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#SettingsTabs QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {{accent_gradient_start}}, stop:1 {{accent_gradient_end}});
    color: {{on_accent}};
    font-weight: 700;
}

#SettingsTabs QTabBar::tab:hover {
    color: {{text_primary}};
}

#SettingsScrollArea {
    background-color: {{bg_primary}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
}

/* --- Satir bilesenleri --- */

#CategoryRow,
#TagRow {
    background-color: {{surface_elevated}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
}

#CategoryRow:hover,
#TagRow:hover {
    border-color: {{accent_color}};
    background-color: {{surface_hover}};
}

#CategoryRowLabel,
#TagRowLabel {
    color: {{text_primary}};
    font-size: 13px;
}

#ColorPreviewBox {
    border-radius: 3px;
}

#ColorPickerButton {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 7px;
    text-align: left;
    min-height: 26px;
}

#ColorPickerButton:hover {
    border-color: {{accent_color}};
}

#ColorPickerText {
    color: {{text_secondary}};
    font-size: 12px;
}

#RowEditField {
    background-color: {{bg_primary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 7px;
    padding: 4px 7px;
    font-size: 12px;
}

#RowEditField:focus {
    border-color: {{focus_ring}};
}

#RowEditButton {
    background-color: transparent;
    color: {{accent_color}};
    border: 1px solid {{accent_color}};
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11px;
}

#RowEditButton:hover {
    background-color: {{nav_selected_bg}};
}

#RowSaveButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_gradient_start}}, stop:1 {{accent_gradient_end}});
    color: {{on_accent}};
    border: none;
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}

#RowSaveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_secondary}}, stop:1 {{accent_gradient_end}});
}

#RowCancelButton {
    background-color: transparent;
    color: {{text_secondary}};
    border: 1px solid {{border_color}};
    border-radius: 7px;
    padding: 4px 6px;
    font-size: 11px;
}

#RowDeleteButton {
    background-color: transparent;
    color: {{danger_color}};
    border: 1px solid {{danger_color}};
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11px;
}

#RowDeleteButton:hover {
    background-color: {{danger_bg}};
}

#RowDeleteConfirmButton {
    background-color: {{danger_hover}};
    color: {{on_accent}};
    border: none;
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}
